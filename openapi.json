{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Libros",
    "version": "1.0.0",
    "description": "Catálogo de libros. REST en /api/v1 y la misma lógica expuesta con tRPC en /trpc.\n\nAutor: Roberth Melendez (carnet 2500461)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Libros"
    }
  ],
  "paths": {
    "/api/v1/libros": {
      "get": {
        "tags": [
          "Libros"
        ],
        "summary": "Lista los libros con paginación por cursor",
        "description": "Si \"siguiente\" no es null, mándalo como ?cursor= para pedir la página que sigue.",
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orden",
            "in": "query",
            "required": false,
            "schema": {
              "default": "reciente",
              "type": "string",
              "enum": [
                "reciente",
                "titulo"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de libros",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrosPagina"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Libros"
        ],
        "summary": "Crea un libro",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearLibro"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Libro creado",
            "headers": {
              "Location": {
                "description": "URL del libro nuevo",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Libro"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe un libro con ese título",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSimple"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/libros/{id}": {
      "get": {
        "tags": [
          "Libros"
        ],
        "summary": "Busca un libro por id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del libro (UUID)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "El libro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Libro"
                }
              }
            }
          },
          "400": {
            "description": "El id no es un UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSimple"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Libros"
        ],
        "summary": "Actualiza uno o varios campos de un libro",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del libro (UUID)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarLibro"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Libro actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Libro"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSimple"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe un libro con ese título",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSimple"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Libros"
        ],
        "summary": "Borra un libro",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del libro (UUID)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Borrado, sin contenido"
          },
          "400": {
            "description": "El id no es un UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSimple"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Libro": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "autor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "anio": {
            "type": "integer",
            "minimum": 1450,
            "maximum": 2100
          },
          "paginas": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 20000
          },
          "leido": {
            "type": "boolean"
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "titulo",
          "autor",
          "anio",
          "paginas",
          "leido",
          "creadoEn"
        ],
        "additionalProperties": false
      },
      "CrearLibro": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "autor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "anio": {
            "type": "integer",
            "minimum": 1450,
            "maximum": 2100
          },
          "paginas": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 20000
          },
          "leido": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "titulo",
          "autor",
          "anio",
          "paginas"
        ],
        "additionalProperties": false
      },
      "ActualizarLibro": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "autor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "anio": {
            "type": "integer",
            "minimum": 1450,
            "maximum": 2100
          },
          "paginas": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 20000
          },
          "leido": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "LibrosPagina": {
        "type": "object",
        "properties": {
          "datos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "titulo": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 120
                },
                "autor": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80
                },
                "anio": {
                  "type": "integer",
                  "minimum": 1450,
                  "maximum": 2100
                },
                "paginas": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 20000
                },
                "leido": {
                  "type": "boolean"
                },
                "creadoEn": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "id",
                "titulo",
                "autor",
                "anio",
                "paginas",
                "leido",
                "creadoEn"
              ],
              "additionalProperties": false
            }
          },
          "siguiente": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "datos",
          "siguiente",
          "total"
        ],
        "additionalProperties": false
      },
      "ErrorValidacion": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "const": 400
          },
          "message": {
            "type": "string"
          },
          "errores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensaje": {
                  "type": "string"
                }
              },
              "required": [
                "campo",
                "mensaje"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "statusCode",
          "message",
          "errores"
        ],
        "additionalProperties": false
      },
      "ErrorSimple": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ],
        "additionalProperties": false
      }
    }
  }
}
